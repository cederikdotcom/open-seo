PORT=3001
ALLOWED_HOST=openseo.cederik.com
OPENSEO_TELEMETRY_DISABLED=1
# Set this to unlock keyword/backlink/rank/SERP data. Base64 of DataForSEO login:password.
# See https://github.com/cederikdotcom/open-seo/blob/main/docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=REPLACE_ME_base64_of_login:password
# Optional: enables SAM, the in-app SEO agent
OPENROUTER_API_KEY=
# Optional: Google Search Console + GA4 (real clicks/impressions, conversions).
# See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md and docs/SELF_HOSTING_GOOGLE_ANALYTICS.md.
# BETTER_AUTH_SECRET encrypts stored OAuth grants: generate once (openssl rand -base64 32)
# and NEVER change it afterwards, or the stored Google connections break.
BETTER_AUTH_SECRET=REPLACE_ME_32_chars_min_generate_once
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
